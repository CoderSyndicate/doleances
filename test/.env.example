# Local development environment for `go run ./test`.
#
# Copy this file to test/.env and fill in what you need. test/.env is
# gitignored; this template is not, so never put a real secret in here.
#
#     cp test/.env.example test/.env
#
# Every name is the same setting as the matching flag, upper-cased with the
# DOLEANCES_ prefix: --llm-api-key is DOLEANCES_LLM_API_KEY. Anything exported
# in your shell wins over this file.

# --- LLM service ---------------------------------------------------------
# Where the backend reaches the model. An OpenAI-compatible endpoint, and the
# version segment is part of it — completions live at {base}/chat/completions,
# so a Synergia instance is https://your-instance/v1 rather than the bare host.
DOLEANCES_LLM_BASE_URL=

# The API key. This is the reason this file exists: it must not be on a
# command line, where it lands in shell history and in `ps` output.
DOLEANCES_LLM_API_KEY=

# Models used for curation assessment and for translating historical texts.
DOLEANCES_LLM_CLASSIFICATION_MODEL=Ministral-3-14B-Instruct-2512
DOLEANCES_LLM_TRANSLATION_MODEL=Ministral-3-14B-Instruct-2512

# Used to deduplicate subjects. bge-m3 is multilingual, which is what lets the
# same subject written in French and German resolve to one.
DOLEANCES_LLM_EMBEDDING_MODEL=bge-m3

# --- Reverse geocoding ---------------------------------------------------
# Nominatim needs no key, but its usage policy asks for a contact so an
# operator can be reached before being blocked. Your own address.
# DOLEANCES_GEOCODE_CONTACT=you@example.org

# Set to false when seeding a lot of test data: the public Nominatim allows
# only 4 requests a minute for anything running in bulk.
# DOLEANCES_GEOCODE_ENABLED=true

# --- Mail ----------------------------------------------------------------
# DOLEANCES_SMTP_HOST=
# DOLEANCES_SMTP_USERNAME=
# DOLEANCES_SMTP_PASSWORD=

# --- Snapshots -----------------------------------------------------------
# The export containing personal data is off unless this is set.
# DOLEANCES_SNAPSHOT_FULL_ENABLED=true
